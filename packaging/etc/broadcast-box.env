# Broadcast Box systemd environment file.
#
# This file is installed to /etc/broadcast-box/broadcast-box.env by the
# Debian package and is loaded by systemd before starting broadcast-box.
# Package helpers may generate /etc/broadcast-box/nat.env, but they should
# not rewrite this administrator-owned file.
#
# Values shown without "#" are the packaged defaults. Optional settings are
# commented out; uncomment and edit them when you need that behavior.


# Server
# ------

# Selects which dotenv file the app tries to load before systemd-provided
# variables. Use "production" for deployed systems.
APP_ENV=production

# Address and port for the main HTTP server. This is also used as the HTTPS
# bind address when SSL_CERT and SSL_KEY are set.
HTTP_ADDRESS=:8080

# Enables a separate HTTP listener that redirects clients to HTTPS.
# ENABLE_HTTP_REDIRECT=true

# Port used by the HTTP-to-HTTPS redirect listener when redirects are enabled.
# HTTPS_REDIRECT_PORT=80

# Runs a startup connectivity check. Keep enabled in production unless you are
# debugging known network or port-forwarding issues.
NETWORK_TEST_ON_START=true

# Disables /api/status. This hides stream discovery on the homepage and breaks
# /statistics, but viewers can still watch if they know the stream link.
# DISABLE_STATUS=true

# Enables pprof profiling on localhost:6060.
# ENABLE_PROFILING=true


# SSL
# ---

# Path to the TLS certificate. Set together with SSL_KEY to make the Go server
# serve HTTPS directly instead of plain HTTP.
# SSL_CERT=/etc/broadcast-box/cert.pem

# Path to the TLS private key. Set together with SSL_CERT.
# SSL_KEY=/etc/broadcast-box/key.pem


# Authorization and Profiles
# --------------------------

# Directory used to store reserved stream profile files. The service runs with
# WorkingDirectory=/var/lib/broadcast-box, so the app default "profiles" means
# /var/lib/broadcast-box/profiles.
# STREAM_PROFILE_PATH=profiles

# Controls who may publish streams.
# ANYONE_WITH_RESERVED: unreserved keys can stream; reserved keys need a token.
# RESERVED: only reserved profiles with valid tokens can stream. NETWORK_TEST_ON_START must be set to false because it will fail and the server wont start
# Generate profiles and tokens with su -s /bin/bash broadcast-box -c 'cd /var/lib/broadcast-box && DISABLE_FRONTEND=true broadcast-box -createNewProfile -streamKey Alice'. Viewer url will be https://yours-site.example/Alice
# After creating a profile restart the service with systemctl restart broadcast-box

# Optional webhook used to approve or reject WHIP publishing and WHEP viewing.
# Use this only when you need custom auth or logging for streamers/viewers.
# WEBHOOK_URL=https://example.com/broadcast-box-webhook


# Frontend
# --------

# Disables serving the bundled web UI routes such as /, /publish, /statistics,
# and /admin. The backend API remains available.
# DISABLE_FRONTEND=true

# Location of the built frontend assets installed by the Debian package.
FRONTEND_PATH=/usr/lib/broadcast-box/web/build

# Enables the /admin UI and protects /api/admin/* endpoints with this bearer
# token. Set this to a strong secret if you want to use the admin portal.
# FRONTEND_ADMIN_TOKEN=


# WebRTC and Networking
# ---------------------

# Single UDP port used for both WHIP ingest and WHEP playback media. This is
# convenient for firewalls and NAT port forwarding.
UDP_MUX_PORT=50000

# UDP port used only for WHIP ingest media. Overrides UDP_MUX_PORT for WHIP.
# UDP_MUX_PORT_WHIP=50000

# UDP port used only for WHEP playback media. Overrides UDP_MUX_PORT for WHEP.
# UDP_MUX_PORT_WHEP=50000

# TCP address used for WebRTC ICE TCP mux, for example ":50000" or
# "0.0.0.0:50000".
# TCP_MUX_ADDRESS=:50000

# Forces WebRTC ICE candidates to TCP only.
# TCP_MUX_FORCE=true

# Restricts WebRTC traffic to a single network interface name.
# INTERFACE_FILTER=eth0

# Network types to allow, separated with "|". Common values include udp4,
# udp6, tcp4, and tcp6.
# NETWORK_TYPES=udp4|udp6

# Includes loopback candidates in WebRTC ICE negotiation.
# INCLUDE_LOOPBACK_CANDIDATE=true

# Automatically detects the public IP and advertises it as a NAT 1:1 address.
# INCLUDE_PUBLIC_IP_IN_NAT_1_TO_1_IP=true

# Manually advertises one or more public NAT 1:1 IPs, separated with "|".
# The NAT refresh helper writes this setting to /etc/broadcast-box/nat.env.
# NAT_1_TO_1_IP=203.0.113.10

# Set to "srflx" to advertise NAT_1_TO_1_IP values as server-reflexive
# candidates instead of host candidates.
# NAT_ICE_CANDIDATE_TYPE=srflx

# Appends extra ICE candidates to generated answers. Use only for special
# network setups that need candidates the WebRTC agent does not generate.
# APPEND_CANDIDATE=

# Pipe-separated STUN server URLs used by WebRTC, for example
# "stun:stun.l.google.com:19302|stun:stun1.l.google.com:19302".
# STUN_SERVERS=stun:stun.l.google.com:19302

# Dynamic DNS hostname used by the Debian NAT refresh helper. The helper
# resolves this host and writes NAT_1_TO_1_IP to /etc/broadcast-box/nat.env.
NAT_1_TO_1_HOST=


# Chat
# ----

# Maximum number of chat messages retained per stream in memory.
# CHAT_MAX_HISTORY=10000

# How long idle chat sessions remain valid. Go duration format, such as 72h.
# CHAT_DEFAULT_TTL=72h

# How often expired chat sessions are removed. Go duration format.
# CHAT_CLEANUP_INTERVAL=1h


# Debugging
# ---------

# Logs incoming API request paths.
# DEBUG_INCOMING_API_REQUEST=true

# Logs WebRTC offers received from clients. Offers may contain sensitive
# connection details, so enable only while debugging.
# DEBUG_PRINT_OFFER=true

# Logs WebRTC answers generated by the server. Enable only while debugging.
# DEBUG_PRINT_ANSWER=true

# Logs Server-Sent Events messages sent to clients.
# DEBUG_PRINT_SSE_MESSAGES=true


# Logging
# -------

# Set to false to disable file logging and keep standard Go logging behavior.
# LOGGING_ENABLED=false

# Minimum log level. Supported values are DEBUG, INFO, WARN, and ERROR.
# LOGGING_LEVEL=INFO

# Directory where log files are written. Relative paths are relative to
# /var/lib/broadcast-box because of the systemd WorkingDirectory.
# LOGGING_DIRECTORY=/var/log/broadcast-box

# Writes all logs to a single file named "log" instead of date-stamped files.
# LOGGING_SINGLEFILE=true

# Truncates the current log file on startup instead of appending to it.
# LOGGING_NEW_FILE_ON_STARTUP=true

# Enables the /api/log endpoint.
# LOGGING_API_ENABLED=true

# Optional bearer token required by /api/log when the logging API is enabled.
# LOGGING_API_KEY=
